# Install outside the checkout as /etc/nit/runtime.env, owned by root:nit, mode 0640.
# This file contains names/placeholders only. Do not commit a filled copy.
NIT_ENVIRONMENT=production
NIT_CONFIG_PATH=/etc/nit/runtime.yaml
NIT_EXECUTION_FACTS_CONFIG_PATH=/etc/nit/execution-facts.json
NIT_PAPER_COMMAND_PATH=/etc/nit/paper-serve.json
NIT_CONSOLE_CONFIG_PATH=/etc/nit/console.json
NIT_TELEGRAM_BOT_TOKEN=REPLACE_ME
NIT_X_CAPTURE_CONFIG_PATH=/etc/nit/x-capture.json
NIT_X_BEARER_TOKEN=REPLACE_ME
# Separate text producer; private calibrated policy and optional interpreter grant.
# NIT_NARRATIVE_CONFIG_PATH=/etc/nit/narratives.json
# NIT_NARRATIVE_GATEWAY_BEARER_TOKEN=REPLACE_ME
NIT_CONTROL_HOST=127.0.0.1
PORT=3000
# Optional observer stays disabled until its explicit grant and gateway are configured.
# NIT_AGENT_CONFIG_PATH=/etc/nit/agent.json
# NIT_AGENT_COMMAND_PATH=/etc/nit/agent-serve.json
# NIT_AGENT_GATEWAY_BEARER_TOKEN=REPLACE_ME
