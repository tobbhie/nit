# Template for the local `.env`. Copy it, then fill in the password:
#
#   cp env.example .env
#
# `.env` is gitignored and on the .agentignore deny list. This template is
# committed, so it must never contain a real password.
#
# Named without the leading dot on purpose: scripts/verify-boundaries.ps1
# rejects every `.env*` file in the tree, and that check is deliberately blunt.
#
# Only the local development database belongs in `.env`. Real secrets, production
# credentials, wallet keys, and anything whose compromise would be consequential
# do not — see AGENTS.md.

# Connection string for the disposable NIT development database.
# Leave unset and the database-backed test suites skip; `pnpm test` still passes.
#
# The suites create and drop a schema per file (nit_test_queue, nit_test_worker,
# nit_test_migrations), so do not point this at a database holding data you care
# about.
NIT_TEST_DATABASE_URL=postgresql://nit_dev:REPLACE_ME@localhost:5432/nit_dev

# Real Solana intake is disabled until all values are supplied through the
# deployment secret/configuration system. Never commit provider API keys here.
NIT_SOLANA_MARKET_ENABLED=false
NIT_SOLANA_RPC_HTTP_ENDPOINT=
NIT_SOLANA_RPC_WEBSOCKET_ENDPOINT=
NIT_PUMP_FUN_PROGRAM_ADDRESS=
NIT_PUMPSWAP_PROGRAM_ADDRESS=

# Wallet intelligence is opt-in. Keep the real watchlist and convergence
# thresholds in private runtime configuration; this template carries names only.
NIT_SOLANA_WALLET_ENABLED=false
NIT_SOLANA_WALLET_RPC_HTTP_ENDPOINT=
NIT_SOLANA_WALLET_RPC_WEBSOCKET_ENDPOINT=
NIT_WATCHED_WALLET_ADDRESSES=
NIT_WALLET_QUOTE_ASSETS=
NIT_WALLET_SWAP_PROGRAM_ADDRESSES=
NIT_WALLET_REQUEST_TIMEOUT_MS=15000
NIT_WALLET_MIN_REQUEST_INTERVAL_MS=200
NIT_WALLET_CONVERGENCE_WINDOW_MS=
NIT_WALLET_CONVERGENCE_MIN_INDEPENDENT=
NIT_WALLET_RECONCILIATION_INTERVAL_MS=60000
NIT_WALLET_RECONCILIATION_OVERLAP_SLOTS=250
NIT_WALLET_INITIAL_LOOKBACK_SLOTS=2000
NIT_WALLET_RECONCILIATION_PAGE_SIZE=1000

# Optional operator-owned JSON command for the standalone paper worker.
# Keep real strategy settings in private runtime files.
NIT_PAPER_COMMAND_PATH=
