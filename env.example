# Local template: copy to .env, then replace the required database placeholders.
# Never commit a filled copy. Use only NIT-specific disposable credentials here.
# Real watchlists, tuned policies and production credentials stay outside checkout.
# Run local commands from the repository root; they explicitly load .env.
# Optional settings are commented out so placeholders cannot enable a worker.

# Required for the first local control API start. Do not use a superuser role.
NODE_ENV=development
NIT_ENVIRONMENT=development
NIT_CONFIG_PATH=config/development.sanitized.yaml
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nit_dev
DB_USER=nit_dev
DB_PASSWORD=REPLACE_WITH_NIT_LOCAL_PASSWORD
DB_SSL=false
# Supabase TLS: public CA, not a private key. Local launcher loads it at startup.
# NODE_EXTRA_CA_CERTS=config/certs/supabase-prod-ca-2021.crt
DB_POOL_MIN=0
DB_POOL_MAX=2
NIT_CONTROL_HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Build identity (optional). GIT_COMMIT is an actual commit ID, never a credential.
# NIT_SCHEMA_VERSION=1.0.0
# NIT_BUILD_ID=local
# GIT_COMMIT=REPLACE_WITH_COMMIT_SHA

# Keep disabled for the initial local control API check.
FEATURE_PRIVATE_INTELLIGENCE=false
FEATURE_PRODUCTION_ALERTS=false
FEATURE_EXECUTION=false
FEATURE_PRIVATE_SOURCES=false

# Solana market discovery: enable only after supplying both RPC endpoints and IDs.
NIT_SOLANA_MARKET_ENABLED=false
# NIT_SOLANA_RPC_HTTP_ENDPOINT=https://rpc.example.invalid/YOUR_NIT_RPC_KEY
# NIT_SOLANA_RPC_WEBSOCKET_ENDPOINT=wss://rpc.example.invalid/YOUR_NIT_RPC_KEY
# NIT_PUMP_FUN_PROGRAM_ADDRESS=REPLACE_WITH_VERIFIED_PROGRAM_ADDRESS
# NIT_PUMPSWAP_PROGRAM_ADDRESS=REPLACE_WITH_VERIFIED_PROGRAM_ADDRESS
# NIT_SOLANA_REQUEST_TIMEOUT_MS=15000
# NIT_SOLANA_MIN_REQUEST_INTERVAL_MS=200
# NIT_SOLANA_RECONCILIATION_INTERVAL_MS=60000
# NIT_SOLANA_RECONCILIATION_ENABLED=true
# NIT_SOLANA_RECONCILIATION_OVERLAP_SLOTS=250
# NIT_SOLANA_INITIAL_LOOKBACK_SLOTS=2000
# NIT_SOLANA_RECONCILIATION_PAGE_SIZE=1000
# Optional market execution-facts producer: operator-owned JSON, not an API key.
# NIT_EXECUTION_FACTS_CONFIG_PATH=C:/nit-local/execution-facts.json

# Wallet intelligence: supply a real NIT watchlist privately before enabling.
NIT_SOLANA_WALLET_ENABLED=false
# NIT_SOLANA_WALLET_RPC_HTTP_ENDPOINT=https://rpc.example.invalid/YOUR_NIT_RPC_KEY
# NIT_SOLANA_WALLET_RPC_WEBSOCKET_ENDPOINT=wss://rpc.example.invalid/YOUR_NIT_RPC_KEY
# NIT_WATCHED_WALLET_ADDRESSES=REPLACE_WITH_COMMA_SEPARATED_WALLET_ADDRESSES
# NIT_WALLET_QUOTE_ASSETS=SOL
# NIT_WALLET_SWAP_PROGRAM_ADDRESSES=REPLACE_WITH_COMMA_SEPARATED_PROGRAM_ADDRESSES
# NIT_WALLET_REQUEST_TIMEOUT_MS=15000
# NIT_WALLET_MIN_REQUEST_INTERVAL_MS=200
# NIT_WALLET_CONVERGENCE_WINDOW_MS=REPLACE_WITH_PRIVATE_INTEGER
# NIT_WALLET_CONVERGENCE_MIN_INDEPENDENT=REPLACE_WITH_PRIVATE_INTEGER
# NIT_WALLET_RECONCILIATION_INTERVAL_MS=60000
# NIT_WALLET_RECONCILIATION_OVERLAP_SLOTS=250
# NIT_WALLET_INITIAL_LOOKBACK_SLOTS=2000
# NIT_WALLET_RECONCILIATION_PAGE_SIZE=1000

# X capture. JSON contains author IDs, capture window and request/page limits.
# NIT_X_CAPTURE_CONFIG_PATH=C:/nit-local/x-capture.json
# NIT_X_BEARER_TOKEN=REPLACE_WITH_NIT_X_BEARER_TOKEN

# Narrative producer. JSON contains policy, gateway/model/grants and media limits.
# NIT_NARRATIVE_CONFIG_PATH=C:/nit-local/narratives.json
# NIT_NARRATIVE_GATEWAY_BEARER_TOKEN=REPLACE_WITH_NIT_GATEWAY_BEARER_TOKEN
# R2 is required only when rich media storage is configured in that JSON.
# NIT_R2_ACCESS_KEY_ID=REPLACE_WITH_NIT_BUCKET_ACCESS_KEY_ID
# NIT_R2_SECRET_ACCESS_KEY=REPLACE_WITH_NIT_BUCKET_SECRET_ACCESS_KEY

# Paper worker: explicit create/serve/tick command JSON and registered portfolios.
# NIT_PAPER_COMMAND_PATH=C:/nit-local/paper-command.json
# Telegram console: JSON contains the operator/chat/portfolio allowlists.
# NIT_CONSOLE_CONFIG_PATH=C:/nit-local/console.json
# NIT_TELEGRAM_BOT_TOKEN=REPLACE_WITH_NIT_TELEGRAM_BOT_TOKEN

# Optional observe-only agent; leave disabled for the first local check.
# NIT_AGENT_CONFIG_PATH=C:/nit-local/agent.json
# NIT_AGENT_COMMAND_PATH=C:/nit-local/agent-command.json
# NIT_AGENT_GATEWAY_BEARER_TOKEN=REPLACE_WITH_NIT_OBSERVER_GATEWAY_BEARER_TOKEN
# Optional one-off research/replay worker command; not a startup prerequisite.
# NIT_RESEARCH_COMMAND_PATH=C:/nit-local/research-command.json

# Tests only: independent from DB_* runtime credentials. The suites create/drop
# isolated schemas; never point this at a database with valuable data.
# NIT_TEST_DATABASE_URL=postgresql://nit_dev:REPLACE_ME@127.0.0.1:5432/nit_test
# Optional real decoder tests; runtime decoder paths belong in narratives.json.
# NIT_TEST_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# NIT_TEST_FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
